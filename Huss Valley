            if d:IsA("Decal") then d.Transparency = 1 end
        end end)
    end
    local preset = MORPH_PRESETS[S.MorphPreset]
    if preset and S.MorphPreset ~= "Normal" then
        pcall(function()
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum then
                local map = { BodyHeightScale = preset[1], BodyWidthScale = preset[2], BodyDepthScale = preset[3], HeadScale = preset[4] }
