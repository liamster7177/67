local function hrpOf(p) local c = p.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function myHum() local c = LP.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function alive(p) local c = p.Character; return c and c:IsDescendantOf(Workspace) and c:FindFirstChild("HumanoidRootPart") ~= nil end
local function roleOf(p) local ok, r = pcall(function() return p:GetAttribute("GameRole") end); return ok and tostring(r) or "?" end
local function isRunner(p) return roleOf(p) == "Runner" end
local function isCatcher(p) return roleOf(p) == "Catcher" end
local function headPart(ch) return ch and (ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")) end
local function keyHeld(name)
    if not name or name == "" or name == "None" then return true end
    if name == "MouseButton2" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
    local ok, code = pcall(function() return Enum.KeyCode[name] end)
    return (ok and code and UIS:IsKeyDown(code)) or false
end

local COH = RS:FindFirstChild("ChickenOrHero")
local function remote(path)
    local node = COH
    for seg in string.gmatch(path, "[^%.]+") do
        if not node then return nil end
        node = node:FindFirstChild(seg)
    end
    return node
end
