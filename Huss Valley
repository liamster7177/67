local flyConn, flyActive = nil, false
local flyLastPos, flyVel, flySnapSlow, flySnapCount, flyReval, flyRevalUntil, flyBurst
local FLY_SNAP_LIMIT, FLY_REVAL_PAUSE = 5, 0.6
local function stopFly()
    flyActive = false; flyLastPos = nil; flyVel = Vector3.zero
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    local h = myHum()
    task.delay(0.15, function()
        local hum = myHum() or h
        if hum then pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Landed, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
        end) end
    end)
end
local function startFly()
    if flyActive then return end
    local root = hrpOf(LP); local hum = myHum()
    if not root or not hum then return end
    root.CFrame = root.CFrame + Vector3.new(0, 3, 0)
    root.AssemblyLinearVelocity = Vector3.new(0, 10, 0)
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Landed, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end)
    flyLastPos, flyVel, flySnapSlow, flySnapCount, flyReval, flyBurst, flyActive = root.Position, Vector3.zero, 1.0, 0, false, 0, true
    flyConn = RunService.Heartbeat:Connect(function(dt)
        if not S.Fly then stopFly(); return end
        local r, h = hrpOf(LP), myHum()
        if not r then stopFly(); return end
        pcall(function()
            if h then
                h:SetStateEnabled(Enum.HumanoidStateType.Landed, false)
                h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                local st = h:GetState()
                if st == Enum.HumanoidStateType.Landed or st == Enum.HumanoidStateType.FallingDown then h:ChangeState(Enum.HumanoidStateType.GettingUp) end
            end
        end)
        if flyReval then
            if os.clock() < flyRevalUntil then
                r.AssemblyLinearVelocity = Vector3.new((math.random()-0.5)*2, -2, (math.random()-0.5)*2); flyLastPos = r.Position; return
            else flyReval = false; flySnapSlow = 0.4; flyVel = Vector3.zero end
        end
        if flyLastPos then
            local actual = (r.Position - flyLastPos).Magnitude / math.max(dt, 0.001)
            local expected = flyVel.Magnitude
            if expected > 15 and actual < expected * 0.25 then
                flySnapSlow = math.max(0.15, flySnapSlow - 0.2); flySnapCount = flySnapCount + 1
                if flySnapCount >= FLY_SNAP_LIMIT then flyReval = true; flyRevalUntil = os.clock() + FLY_REVAL_PAUSE; flySnapCount = 0; flyVel = Vector3.zero; flyLastPos = r.Position; return end
            else flySnapSlow = math.min(1.0, flySnapSlow + 0.025); if flySnapCount > 0 then flySnapCount = flySnapCount - 1 end end
        end
        flyLastPos = r.Position
        local eff = (S.FlySpeed or 90) * flySnapSlow
        local dir = moveDir()
        local targetVel = dir.Magnitude > 0.01 and dir.Unit * eff or Vector3.zero
        flyVel = flyVel:Lerp(targetVel, math.min(1, dt * (10 + math.random() * 4)))
        local hSpeed = Vector3.new(flyVel.X, 0, flyVel.Z).Magnitude
        local gravBias = hSpeed > 30 and Vector3.new(0, -hSpeed * 0.04, 0) or Vector3.zero
        flyBurst = (flyBurst + 1) % 5
        if flyBurst == 0 and not UIS:IsKeyDown(Enum.KeyCode.Space) and flyVel.Magnitude > 10 then
            r.AssemblyLinearVelocity = flyVel * 0.6 + gravBias
        else
            r.AssemblyLinearVelocity = flyVel + gravBias
        end
    end)
end

