task.spawn(function()
    while true do
        task.wait(0.1)
        if S.AutoEvade then
            local hrp = hrpOf(LP)
            local catcher, d = nearestCatcher()
            if hrp and catcher and d and d <= S.EvadeDist and (os.clock() - lastEvade) > 0.35 then
                lastEvade = os.clock()
                local ch = hrpOf(catcher)
                local away = hrp.Position - ch.Position
                away = Vector3.new(away.X, 0, away.Z)
                if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) else away = away.Unit end
                local side = Vector3.new(-away.Z, 0, away.X) * evadeSide
                evadeSide = -evadeSide
                local dest = hrp.Position + (away * S.EvadeBlink) + (side * (S.EvadeBlink * 0.6))
                pcall(function() hrp.CFrame = CFrame.new(dest) * (hrp.CFrame - hrp.CFrame.Position) end)
            end
        end
    end
end)

