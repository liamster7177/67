local evadeSide = 1
local lastEvade = 0
local function nearestCatcher()
    local hrp = hrpOf(LP); if not hrp then return nil, nil end
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) and isCatcher(p) then
            local h = hrpOf(p)
            if h then local d = (h.Position - hrp.Position).Magnitude; if d < bestD then best, bestD = p, d end end
        end
