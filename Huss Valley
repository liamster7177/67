local function aimTarget()
    local myHrp = hrpOf(LP); if not myHrp then return nil end
    local wantRunner = (roleOf(LP) ~= "Runner")
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            local ok = S.AimTeamCheck and ((wantRunner and isRunner(p)) or (not wantRunner and isCatcher(p))) or (not S.AimTeamCheck)
            if ok then
                local h = headPart(p.Character)
                if h then
                    local sp, on = Cam:WorldToViewportPoint(h.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - Cam.ViewportSize / 2).Magnitude
                        if d < (S.AimFOV or 250) and d < bestD then best, bestD = h, d end
                    end
                end
            end
        end
    end
    return best
end
