end)

local espPool = {}
local function getEsp(i)
    local e = espPool[i]; if e then return e end
    local box = Drawing.new("Square"); box.Thickness, box.Filled, box.Visible = 1, false, false
    local boxo = Drawing.new("Square"); boxo.Thickness, boxo.Filled, boxo.Visible, boxo.Color = 3, false, false, Color3.new(0,0,0)
    local nm = Drawing.new("Text"); nm.Size, nm.Center, nm.Outline, nm.Visible = 13, true, true, false
    local ds = Drawing.new("Text"); ds.Size, ds.Center, ds.Outline, ds.Visible = 12, true, true, false
    local tr = Drawing.new("Line"); tr.Thickness, tr.Visible = 1, false
    e = { box=box, boxo=boxo, nm=nm, ds=ds, tr=tr }; espPool[i] = e; return e
end
local function hideEsp(e) e.box.Visible, e.boxo.Visible, e.nm.Visible, e.ds.Visible, e.tr.Visible = false,false,false,false,false end
RunService.RenderStepped:Connect(function()
    local i = 0
    if S.EspOn then
        local myp = hrpOf(LP) and hrpOf(LP).Position
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and alive(p) then
                local hrp = hrpOf(p)
                local head = p.Character:FindFirstChild("Head") or hrp
                local dist = myp and (hrp.Position - myp).Magnitude or 0
                if hrp and dist <= S.EspMaxDist then
                    local col = isCatcher(p) and S.EspCatcher or S.EspRunner
                    local topp, on1 = Cam:WorldToViewportPoint((head.Position + Vector3.new(0,0.7,0)))
                    local botp = Cam:WorldToViewportPoint((hrp.Position - Vector3.new(0,3,0)))
                    if on1 then
                        i = i + 1
                        local e = getEsp(i)
                        local h = math.abs(topp.Y - botp.Y)
                        local w = h * 0.55
                        local cx, cy = topp.X, topp.Y
                        if S.EspBox then
                            e.box.Size = Vector2.new(w, h); e.box.Position = Vector2.new(cx - w/2, cy)
                            e.box.Color = col; e.box.Visible = true
                            e.boxo.Size = e.box.Size; e.boxo.Position = e.box.Position; e.boxo.Visible = true
                        else e.box.Visible, e.boxo.Visible = false, false end
                        if S.EspName then
                            e.nm.Text = p.Name .. " [" .. roleOf(p):sub(1,1) .. "]"
                            e.nm.Position = Vector2.new(cx, cy - 16); e.nm.Color = col; e.nm.Visible = true
                        else e.nm.Visible = false end
                        if S.EspDist then
                            e.ds.Text = math.floor(dist) .. "m"
                            e.ds.Position = Vector2.new(cx, cy + h + 2); e.ds.Color = col; e.ds.Visible = true
                        else e.ds.Visible = false end
                        if S.EspTracer then
                            e.tr.From = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y)
                            e.tr.To = Vector2.new(cx, cy + h); e.tr.Color = col; e.tr.Visible = true
                        else e.tr.Visible = false end
                    end
                end
            end
        end
    end
    for j = i + 1, #espPool do hideEsp(espPool[j]) end
end)

local chamsFolder = Instance.new("Folder"); chamsFolder.Name = "ORIGIN_chams"
pcall(function() chamsFolder.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
local CHAMS_STYLES = { "Highlight", "Neon", "ForceField", "Glass" }
local CHAMS_MATERIAL = { Neon = Enum.Material.Neon, ForceField = Enum.Material.ForceField, Glass = Enum.Material.Glass }
local chamsState = {}
local function chamsEntry(m) local e = chamsState[m]; if not e then e = { hl=nil, parts={} }; chamsState[m] = e end return e end
local function restoreParts(e) for part,o in pairs(e.parts) do pcall(function() if part and part.Parent then part.Material=o.mat; part.Color=o.col; part.Transparency=o.tr end end) end e.parts = {} end
local function applyChams(model, color)
    if not model then return end
    local e = chamsEntry(model); local style = S.ChamsStyle or "Highlight"
    if style == "Highlight" then
        restoreParts(e)
        local hl = e.hl
        if not hl or hl.Parent ~= chamsFolder then hl = Instance.new("Highlight"); hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent = chamsFolder; e.hl = hl end
        pcall(function() hl.Adornee = model; hl.FillColor = color; hl.OutlineColor = S.ChamsOutline; hl.FillTransparency = S.ChamsFillT; hl.OutlineTransparency = 0; hl.Enabled = true end)
    else
        if e.hl then pcall(function() e.hl.Enabled = false end) end
        local mat = CHAMS_MATERIAL[style] or Enum.Material.Neon
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                if e.parts[d] == nil then e.parts[d] = { mat=d.Material, col=d.Color, tr=d.Transparency } end
                pcall(function() d.Material = mat; d.Color = color; if style=="Glass" then d.Transparency=0.35 elseif style=="ForceField" then d.Transparency=0 end end)
            end
        end
    end
end
RunService.Heartbeat:Connect(function()
    local seen = {}
    if S.ChamsOn then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and alive(p) then local ch = p.Character; seen[ch] = true; applyChams(ch, isCatcher(p) and S.ChamsCatcher or S.ChamsRunner) end
        end
    end
    if S.ChamsSelf and LP.Character then seen[LP.Character] = true; applyChams(LP.Character, S.ChamsSelfColor) end
    for model, e in pairs(chamsState) do
        if not seen[model] then
            restoreParts(e); if e.hl then pcall(function() e.hl.Enabled = false end) end
            if not model or not model.Parent then if e.hl then pcall(function() e.hl:Destroy() end) end chamsState[model] = nil end
        end
    end
end)

