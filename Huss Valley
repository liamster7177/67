local function httpGetBinary(url)
    local body
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local ok, res = pcall(req, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and type(res.Body) == "string" and #res.Body > 0 then
            if res.StatusCode == nil or res.StatusCode == 200 or res.Success then
                body = res.Body
            end
        end
    end
    if not body then
        local ok, res = pcall(function() return game:HttpGet(url, true) end)
        if ok and type(res) == "string" and #res > 0 then body = res end
    end
    if not body then
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok and type(res) == "string" and #res > 0 then body = res end
    end
    return body
end

local imageCache = {}

local function imageKind(data)
    if type(data) ~= "string" or #data < 64 then return nil end
    local b1, b2, b3, b4 = data:byte(1, 4)
    if b1 == 137 and b2 == 80 and b3 == 78 and b4 == 71 then return ".png" end
    if b1 == 255 and b2 == 216 then return ".jpg" end
    if b1 == 71  and b2 == 73 and b3 == 70 then return ".png" end
    if b1 == 82  and b2 == 73 and b3 == 70 and b4 == 70 then return ".png" end
    return nil
end

local function resolveOne(spec, cacheName)
    if type(spec) ~= "string" or spec == "" then return nil, "no image set" end

    if spec:match("^rbxassetid://") or spec:match("^rbxasset://") or spec:match("^rbxthumb://") then
        imageCache[cacheName] = spec
        return spec
    end
    if spec:match("^%d+$") then
        local a = "rbxassetid://" .. spec
        imageCache[cacheName] = a
        return a
    end
    if not spec:match("^https?://") then return nil, "bad image value" end

    local gca = getcustomasset or getsynasset
    if type(gca) ~= "function" then return nil, "no getcustomasset" end
    if type(writefile) ~= "function" then return nil, "no writefile" end

    for _, ext in ipairs({ ".png", ".jpg" }) do
        local cached = "origin_loader_" .. cacheName .. ext
        if type(isfile) == "function" then
            local present = false
            pcall(function() present = isfile(cached) end)
            if present then
                local good = true
                if type(readfile) == "function" then
                    local okR, raw = pcall(readfile, cached)
                    good = okR and imageKind(raw) ~= nil
                end
                if good then
                    local ok, asset = pcall(gca, cached)
                    if ok and asset then return asset end
                elseif type(delfile) == "function" then
                    pcall(delfile, cached)
                end
            end
        end
    end

    local data = httpGetBinary(spec)
    if not data then return nil, "download blocked" end
    if #data < 64 then return nil, "empty download" end

    local ext = imageKind(data)
    if not ext then return nil, "not an image" end

    local file = "origin_loader_" .. cacheName .. ext
    local okW = pcall(writefile, file, data)
    if not okW then return nil, "writefile failed" end

    local ok, asset = pcall(gca, file)
    if not ok or not asset then return nil, "getcustomasset failed" end

    return asset
end

local function resolveImage(spec, cacheName)
    if imageCache[cacheName] then return imageCache[cacheName] end

    local list = spec
    if type(list) ~= "table" then list = { list } end

    local lastWhy = "no image set"
    for i, candidate in ipairs(list) do
        local asset, why = resolveOne(candidate, cacheName .. "_" .. i)
        if asset then
            imageCache[cacheName] = asset
            return asset
        end
        lastWhy = why or lastWhy
        if why == "no getcustomasset" or why == "no writefile" then
            return nil, why
        end
    end
    return nil, lastWhy
end

