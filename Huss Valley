local cfgOrig = {}
local function remember(tbl, key) if tbl and cfgOrig[tbl] == nil then cfgOrig[tbl] = {} end if tbl and cfgOrig[tbl][key] == nil then cfgOrig[tbl][key] = tbl[key] end end
local function setCfg(tbl, key, val) if tbl and tbl[key] ~= nil then remember(tbl, key); tbl[key] = val end end
local function restoreCfg(tbl, key) if tbl and cfgOrig[tbl] and cfgOrig[tbl][key] ~= nil then tbl[key] = cfgOrig[tbl][key] end end
local function restoreAllCfg() for tbl, keys in pairs(cfgOrig) do for k, orig in pairs(keys) do pcall(function() tbl[k] = orig end) end end end

local SWINGCD_HINTS = { "cooldown", "recovery", "debounce", "interval", "refire", "swingdelay", "attackcooldown", "attackspeed", "firerate", "recharge" }
local function keyIsCd(lk) for _, h in ipairs(SWINGCD_HINTS) do if lk:find(h, 1, true) then return true end end return false end
local function sweepSwingCfg()
    local on = S.NoSwingCD
    for _, cfg in ipairs({ mcfg, gcfg, dcfg }) do
        if type(cfg) == "table" then
            local function walk(tbl, depth)
                if depth > 5 then return end
                for k, v in pairs(tbl) do
                    if type(v) == "number" and type(k) == "string" and keyIsCd(k:lower()) then
                        remember(tbl, k)
                        tbl[k] = on and 0.03 or cfgOrig[tbl][k]
                    elseif type(v) == "table" then walk(v, depth + 1) end
                end
            end
            pcall(walk, cfg, 1)
        end
    end
end

local function applyDashCfg()
    local cd = S.NoDodgeCD and 0.05 or nil
    if mcfg and mcfg.Dash then if cd then setCfg(mcfg.Dash, "Cooldown", cd) else restoreCfg(mcfg.Dash, "Cooldown") end end
    if gcfg and gcfg.Tackle then if cd then setCfg(gcfg.Tackle, "Cooldown", cd) else restoreCfg(gcfg.Tackle, "Cooldown") end end
    local m = S.DashRange and (S.DashRangeMult or 1) or 1
    if mcfg and mcfg.Dash then
        remember(mcfg.Dash, "Distance"); mcfg.Dash.Distance = (cfgOrig[mcfg.Dash].Distance) * m
    end
    if gcfg and gcfg.Tackle then
        local T = gcfg.Tackle
        for _, k in ipairs({ "Distance", "Reach", "MaxDistance", "DistanceMultiplier", "RunDistanceMultiplier" }) do
            if T[k] ~= nil then remember(T, k); T[k] = cfgOrig[T][k] * (k:find("Multiplier") and (S.DashRange and ((m - 1) * 0.5 + 1) or 1) or m) end
        end
        if type(T.Variants) == "table" then
            for _, var in pairs(T.Variants) do
                if type(var) == "table" then
                    for _, k in ipairs({ "Distance", "Reach" }) do if var[k] ~= nil then remember(var, k); var[k] = cfgOrig[var][k] * m end end
                end
            end
        end
        if type(T.HumanBox) == "table" and type(T.HumanBox.Reach) == "table" then
            for rk, rv in pairs(T.HumanBox.Reach) do if type(rv) == "number" then remember(T.HumanBox.Reach, rk); T.HumanBox.Reach[rk] = cfgOrig[T.HumanBox.Reach][rk] * m end end
        end
    end
end

