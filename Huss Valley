local captured = {}
pcall(function()
    local re = Instance.new("RemoteEvent")
    local oldFire
    oldFire = hookfunction(re.FireServer, function(self, ...)
        if typeof(self) == "Instance" and (self == MeleeEvent or self == GameAction or self == RescueEvent) then
            if not captured[self] then
                captured[self] = table.pack(...)
                pcall(function() Library:Notify("Learned " .. self.Name .. " call", 4) end)
            end
        end
        return oldFire(self, ...)
    end)
    re:Destroy()
end)
local function fireLearned(rem, fallbackFn)
    if not rem then return end
    local c = captured[rem]
    if c then pcall(function() rem:FireServer(table.unpack(c, 1, c.n)) end)
    elseif fallbackFn then pcall(fallbackFn) end
end

local function serverNow()
    local ok, t = pcall(function() return Workspace:GetServerTimeNow() end)
    return ok and t or (os.time() + (tick() % 1))
end
local function tackleTarget(targetPlayer)
    if not MeleeEvent then return end
    local myHrp = hrpOf(LP); local th = targetPlayer and hrpOf(targetPlayer)
    if not myHrp or not th then return end
    local flat = th.Position - myHrp.Position; flat = Vector3.new(flat.X, 0, flat.Z)
    local dir = flat.Magnitude > 0.1 and flat.Unit or myHrp.CFrame.LookVector
    pcall(function() myHrp.CFrame = CFrame.new(th.Position - dir * 2.5, th.Position) end)
    pcall(function()
        MeleeEvent:FireServer({ id = HttpService:GenerateGUID(false), direction = dir, at = serverNow(), position = (hrpOf(LP) and hrpOf(LP).Position) or myHrp.Position })
    end)
end
local function nearestRunner(range)
    local hrp = hrpOf(LP); if not hrp then return nil end
    local best, bestD = nil, range or 120
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) and (not S.AuraRunnersOnly or isRunner(p)) then
            local h = hrpOf(p)
            if h then local d = (h.Position - hrp.Position).Magnitude; if d < bestD then best, bestD = p, d end end
        end
    end
    return best
end
