local collisionDestroyed = false
local function setNoClip(on)
    if on then
        if not collisionDestroyed then
            local cc = RS:FindFirstChild("Scripts")
                and RS.Scripts:FindFirstChild("CharacterCollision")
            if cc then
                pcall(function() cc:Destroy() end)
                collisionDestroyed = true
                print("[Origin] CharacterCollision destroyed -- noclip active")
            end
        end
    else
        if collisionDestroyed then
            warn("[Origin] noclip off -- rejoin to fully restore collision")
        end
    end
end


local taseRemote = RS:FindFirstChild("GunRemotes") and RS.GunRemotes:FindFirstChild("PlayerTased")
local taseDisabledConns = {}

local function setAntiTase(on)
    if not taseRemote then return end
    if on then
        for _, c in ipairs(getconnections(taseRemote.OnClientEvent)) do
            c:Disable()
            taseDisabledConns[#taseDisabledConns+1] = c
        end
    else
        for _, c in ipairs(taseDisabledConns) do pcall(function() c:Enable() end) end
        taseDisabledConns = {}
    end
end

local flyBV, flyBG, flyConn
local function stopFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyBV then pcall(function() flyBV:Destroy() end); flyBV = nil end
    if flyBG then pcall(function() flyBG:Destroy() end); flyBG = nil end
    local h = myHum(); if h then pcall(function() h.PlatformStand = false end) end
end

local function startFly()
    local hrp, hum = myHrp(), myHum()
    if not hrp or not hum then return end
    stopFly()
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e6,1e6,1e6)
    flyBV.P = 1250
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = hrp
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e6,1e6,1e6)
    flyBG.P, flyBG.D = 3000, 500
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp
    pcall(function() hum.PlatformStand = true end)
    flyConn = RunSvc.RenderStepped:Connect(function()
        if not S.Fly then stopFly() return end
        local h2 = myHrp()
        if not h2 or not flyBV or not flyBV.Parent then stopFly() return end
        local cf = workspace.CurrentCamera.CFrame
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
        flyBV.Velocity = (dir.Magnitude > 0.01) and (dir.Unit * S.FlySpeed) or Vector3.zero
        flyBG.CFrame = CFrame.new(h2.Position,
            h2.Position + Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z))
    end)
end

