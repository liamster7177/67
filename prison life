local tracerFolder = Instance.new("Folder")
tracerFolder.Name = "Origin_Tracers"
tracerFolder.Parent = workspace
local activeTracers = {}

local function makeTracer(from, to)
    if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then return end
    local near = Instance.new("Attachment", workspace.Terrain)
    local far  = Instance.new("Attachment", workspace.Terrain)
    near.Position = from
    far.Position = to
    local beam = Instance.new("Beam")
    beam.Attachment0 = near
    beam.Attachment1 = far
    beam.FaceCamera = true
    beam.LightInfluence = 0
    beam.Width0 = S.TracerThickness
    beam.Width1 = S.TracerThickness
    beam.Color = ColorSequence.new(S.TracerColor)
    beam.LightEmission = 1
    beam.Parent = tracerFolder
    activeTracers[#activeTracers+1] = {
        beam = beam, near = near, far = far,
        born = os.clock(), life = S.TracerLife,
    }
end

RunSvc.RenderStepped:Connect(function()
    if #activeTracers == 0 then return end
    local now = os.clock()
    for i = #activeTracers, 1, -1 do
        local t = activeTracers[i]
        local age = now - t.born
        if age >= t.life then
            pcall(function() t.beam:Destroy() t.near:Destroy() t.far:Destroy() end)
            table.remove(activeTracers, i)
        else
            t.beam.Transparency = NumberSequence.new(1 - age / t.life)
        end
    end
end)


local espPool = {}
local function getEsp(i)
    local e = espPool[i]
    if e then return e end
    local box = Drawing.new("Square")
    box.Thickness, box.Filled, box.Visible = 1, false, false
    local outline = Drawing.new("Square")
    outline.Thickness, outline.Filled, outline.Visible, outline.Color = 3, false, false, Color3.new(0,0,0)
    local name = Drawing.new("Text")
    name.Size, name.Center, name.Outline, name.Visible = 13, true, true, false
    local dist = Drawing.new("Text")
    dist.Size, dist.Center, dist.Outline, dist.Visible = 12, true, true, false
    local hpBg = Drawing.new("Square")
    hpBg.Filled, hpBg.Color, hpBg.Visible = true, Color3.fromRGB(15,15,15), false
    local hpFill = Drawing.new("Square")
    hpFill.Filled, hpFill.Visible = true, false
    local skeleton = {}
    for k = 1, 6 do
        local l = Drawing.new("Line")
        l.Thickness, l.Visible = 1, false
        skeleton[k] = l
    end
    e = { box=box, outline=outline, name=name, dist=dist, hpBg=hpBg, hpFill=hpFill, skeleton=skeleton }
    espPool[i] = e
    return e
end
local function hideEsp(e)
    e.box.Visible, e.outline.Visible = false, false
    e.name.Visible, e.dist.Visible = false, false
    e.hpBg.Visible, e.hpFill.Visible = false, false
    for _, l in ipairs(e.skeleton) do l.Visible = false end
end

local BONES = {
    {"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
    {"Torso","Left Leg"},{"Torso","Right Leg"},
}

local function screenBox(char)
    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not (head and root) then return nil end
    local cam = workspace.CurrentCamera
    local ts, tOn = cam:WorldToViewportPoint(head.Position + Vector3.new(0, head.Size.Y/2 + 0.3, 0))
    local bs, bOn = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.9, 0))
    if not (tOn and bOn) or ts.Z <= 0 then return nil end
    local h = math.abs(bs.Y - ts.Y)
    if h < 4 or h > 2000 then return nil end
    return ts.X - h/4, ts.Y, h/2, h
end

RunSvc.RenderStepped:Connect(function()
    if not S.EspOn then
        -- ensure all drawings hidden when off
        for _, e in ipairs(espPool) do
            if e.box.Visible then hideEsp(e) end
        end
        return
    end

    local cam = workspace.CurrentCamera
    if not cam then return end
    local camPos = cam.CFrame.Position
    local slot = 0

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            local char = p.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and hum then
                local d = (root.Position - camPos).Magnitude
                if d <= S.EspMaxDist then
                    local team = sameTeam(p)
                    local col = team and S.EspTeamColor or S.EspEnemyColor
                    local x, y, w, h = screenBox(char)
                    if x then
                        slot = slot + 1
                        local e = getEsp(slot)
                        if S.EspBox then
                            e.outline.Position, e.outline.Size = Vector2.new(x,y), Vector2.new(w,h)
                            e.outline.Visible = true
                            e.box.Position, e.box.Size, e.box.Color = Vector2.new(x,y), Vector2.new(w,h), col
                            e.box.Visible = true
                        else e.box.Visible, e.outline.Visible = false, false end
                        if S.EspName then
                            e.name.Text, e.name.Color = p.Name, col
                            e.name.Position = Vector2.new(x + w/2, y - 16)
                            e.name.Visible = true
                        else e.name.Visible = false end
                        if S.EspDist then
                            e.dist.Text = string.format("%.0f", d)
                            e.dist.Position = Vector2.new(x + w/2, y + h + 2)
                            e.dist.Color = Color3.fromRGB(220,220,220)
                            e.dist.Visible = true
                        else e.dist.Visible = false end
                        if S.EspHealth then
                            local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                            e.hpBg.Position, e.hpBg.Size = Vector2.new(x - 6, y), Vector2.new(3, h)
                            e.hpBg.Visible = true
                            local fh = math.max(1, h * pct)
                            e.hpFill.Position, e.hpFill.Size = Vector2.new(x - 6, y + h - fh), Vector2.new(3, fh)
                            e.hpFill.Color = Color3.fromRGB(
                                math.floor(255*(1-pct)), math.floor(220*pct), 60)
                            e.hpFill.Visible = true
                        else
                            e.hpBg.Visible, e.hpFill.Visible = false, false
                        end
                        if S.EspSkeleton then
                            for i, pair in ipairs(BONES) do
                                local a, b = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
                                local line = e.skeleton[i]
                                if a and b then
                                    local pa, oa = cam:WorldToViewportPoint(a.Position)
                                    local pb, ob = cam:WorldToViewportPoint(b.Position)
                                    if oa and ob and pa.Z > 0 and pb.Z > 0 then
                                        line.From = Vector2.new(pa.X, pa.Y)
                                        line.To = Vector2.new(pb.X, pb.Y)
                                        line.Color = col
                                        line.Visible = true
                                    else line.Visible = false end
                                else line.Visible = false end
                            end
                        else
                            for _, l in ipairs(e.skeleton) do l.Visible = false end
                        end
                    end
                end
            end
        end
    end
    for i = slot + 1, #espPool do hideEsp(espPool[i]) end
end)

