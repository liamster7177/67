local function pickSilentTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil, nil end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)
    local best, bestScore, bestPart = nil, math.huge, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) then
            local c = p.Character
            local part = c:FindFirstChild(S.SilentTargetPart)
                or c:FindFirstChild("Head")
                or c:FindFirstChild("Torso")
                or c:FindFirstChild("HumanoidRootPart")
            if part then
                local sp, on = cam:WorldToViewportPoint(part.Position)
                if on and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < S.SilentFOV and d < bestScore then
                        bestScore, best, bestPart = d, p, part
                    end
                end
            end
        end
    end
    return best, bestPart
end

local function installCastRay()
    if castRayActive then return true end
    if not filtergc or not hookfunction then
        warn("[Origin] filtergc or hookfunction unavailable")
        return false
    end
    local ok, fn = pcall(filtergc, "function", { Name = "castRay" }, true)
    if not ok or type(fn) ~= "function" then
        warn("[Origin] castRay not found")
        return false
    end
    castRayOriginal = fn   
    local function hooked(...)
        local args = table.pack(...)
        
        if S.SilentAim and silentPart and silentPart.Parent then
            if S.Wallbang then
                return silentPart, silentPart.Position
            end
            if args[1] and typeof(args[1]) == "Vector3" then
                args[2] = silentPart.Position
            end
        end
        return castRayOriginal(table.unpack(args, 1, args.n))
    end
    hookfunction(fn, hooked)
    castRayActive = true
    return true
end

local function uninstallCastRay()
    if not castRayActive or not castRayOriginal then return end
    -- reinstall original by hooking back
    pcall(function()
        local cur = castRayOriginal
        -- find current hooked version by re-running filtergc
        local ok, fn = pcall(filtergc, "function", { Name = "castRay" }, true)
        if ok and type(fn) == "function" then
            hookfunction(fn, castRayOriginal)
        end
    end)
    castRayActive = false
end


