        pcall(function() if currentSky then currentSky:Destroy() end end)
        -- hide drawings
        for _, e in ipairs(espPool) do
            pcall(function()
                e.box:Remove() e.outline:Remove() e.name:Remove() e.dist:Remove()
                e.hpBg:Remove() e.hpFill:Remove()
                for _, l in ipairs(e.skeleton) do l:Remove() end
            end)
        end
        for _, t in ipairs(activeTracers) do
            pcall(function() t.beam:Destroy() t.near:Destroy() t.far:Destroy() end)
        end
        pcall(function() tracerFolder:Destroy() end)
        pcall(function() fovCircle:Remove() end)
        -- unhook castRay
        pcall(uninstallCastRay)
        Library:Unload()
    end,
})

