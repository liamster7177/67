local weaponOrigAttrs = setmetatable({}, { __mode = "k" })

local function saveAttr(tool, attr)
    weaponOrigAttrs[tool] = weaponOrigAttrs[tool] or {}
    if weaponOrigAttrs[tool][attr] == nil then
        weaponOrigAttrs[tool][attr] = tool:GetAttribute(attr)
    end
end
local function revertAttr(tool, attr)
    if weaponOrigAttrs[tool] and weaponOrigAttrs[tool][attr] ~= nil then
        pcall(function() tool:SetAttribute(attr, weaponOrigAttrs[tool][attr]) end)
        weaponOrigAttrs[tool][attr] = nil
    end
end

RunSvc.Heartbeat:Connect(function()
    -- strict gate: nothing to do if all weapon mods are off
    if not (S.NoSpread or S.LongRange or S.FastFire or S.FastReload) then
        -- restore any prior modifications
        for tool, attrs in pairs(weaponOrigAttrs) do
            for attr, orig in pairs(attrs) do
                if tool and tool.Parent and orig ~= nil then
                    pcall(function() tool:SetAttribute(attr, orig) end)
                end
            end
        end
        weaponOrigAttrs = setmetatable({}, { __mode = "k" })
        return
    end

    local char = myChar()
    local backpack = LP:FindFirstChild("Backpack")
    local tools = {}
    if char then for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then tools[#tools+1] = t end
    end end
    if backpack then for _, t in ipairs(backpack:GetChildren()) do
        if t:IsA("Tool") then tools[#tools+1] = t end
    end end

    for _, tool in ipairs(tools) do
        if tool:GetAttribute("SpreadRadius") ~= nil then
            if S.NoSpread then
                saveAttr(tool, "SpreadRadius")
                pcall(function() tool:SetAttribute("SpreadRadius", 0) end)
            else
                revertAttr(tool, "SpreadRadius")
            end
        end
        if tool:GetAttribute("FireRate") ~= nil then
            if S.FastFire then
                saveAttr(tool, "FireRate")
                pcall(function() tool:SetAttribute("FireRate", S.FireRate) end)
            else
                revertAttr(tool, "FireRate")
            end
        end
        if tool:GetAttribute("ReloadTime") ~= nil then
            if S.FastReload then
                saveAttr(tool, "ReloadTime")
                pcall(function() tool:SetAttribute("ReloadTime", 0.15) end)
            else
                revertAttr(tool, "ReloadTime")
            end
        end
        if tool:GetAttribute("Range") ~= nil then
            if S.LongRange then
                saveAttr(tool, "Range")
                pcall(function() tool:SetAttribute("Range", 9999) end)
            else
                revertAttr(tool, "Range")
            end
        end
    end
end)


