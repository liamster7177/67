local MATERIALS = {"ForceField","Neon","Glass","Metal","SmoothPlastic","Marble","Plastic"}
local BODY_PARTS = {
    "Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg",
    "UpperTorso","LowerTorso","LeftUpperArm","LeftLowerArm","LeftHand",
    "RightUpperArm","RightLowerArm","RightHand","LeftUpperLeg","LeftLowerLeg",
    "LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot",
}
local playerChamsSaved = {}

local function applyPlayerChams()
    local char = myChar(); if not char then return end
    local mat = Enum.Material[S.PlayerChamsMat] or Enum.Material.ForceField
    for _, name in ipairs(BODY_PARTS) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            if not playerChamsSaved[part] then
                playerChamsSaved[part] = {
                    Color = part.Color,
                    Material = part.Material,
                    Transparency = part.Transparency,
                }
            end
            pcall(function()
                part.Material = mat
                part.Color = S.PlayerChamsColor
                part.Transparency = S.PlayerChamsTrans
            end)
        end
    end
end

local function restorePlayerChams()
    for p, o in pairs(playerChamsSaved) do
        if p and p.Parent then
            pcall(function()
                p.Color = o.Color
                p.Material = o.Material
                p.Transparency = o.Transparency
            end)
        end
    end
    playerChamsSaved = {}
end

RunSvc.Heartbeat:Connect(function()
    if not S.PlayerChams then return end
    applyPlayerChams()
end)


local gunChamsSaved = {}

local function findGunModel()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    for _, d in ipairs(cam:GetChildren()) do
        if d:IsA("Model") and d:FindFirstChildWhichIsA("BasePart") then
            return d
        end
    end
    return nil
end

local function applyGunChams()
    local gun = findGunModel(); if not gun then return end
    local mat = Enum.Material[S.GunChamsMat] or Enum.Material.Neon
    for _, part in ipairs(gun:GetDescendants()) do
        if part:IsA("BasePart") then
            if not gunChamsSaved[part] then
                gunChamsSaved[part] = { Color = part.Color, Material = part.Material }
            end
            pcall(function()
                part.Material = mat
                part.Color = S.GunChamsColor
            end)
        end
    end
end

local function restoreGunChams()
    for p, o in pairs(gunChamsSaved) do
        if p and p.Parent then
            pcall(function() p.Color = o.Color p.Material = o.Material end)
        end
    end
    gunChamsSaved = {}
end

RunSvc.Heartbeat:Connect(function()
    if not S.GunChams then return end
    applyGunChams()
end)


