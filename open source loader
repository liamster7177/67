local busy = false

local function runScript(entry)
    if busy then return end
    busy = true
    say("downloading " .. entry.title .. " ...", ACCENT)

    task.spawn(function()
        local okGet, source = pcall(function() return game:HttpGet(entry.url, true) end)
        if not okGet or type(source) ~= "string" or #source < 100 then
            say("download failed — check your connection", Color3.fromRGB(235, 120, 120))
            busy = false
            return
        end

        say("compiling " .. entry.title .. " ...", ACCENT)
        local fn, compileErr = loadstring(source)
        if not fn then
            say("compile error: " .. tostring(compileErr), Color3.fromRGB(235, 120, 120))
            busy = false
            return
        end

        say("running " .. entry.title .. " ...", ACCENT)
        gui.Enabled = false

        local okRun, runErr = pcall(fn)
        if not okRun then
            gui.Enabled = true
            say("runtime error: " .. tostring(runErr), Color3.fromRGB(235, 120, 120))
            busy = false
            return
        end

        task.wait(0.4)
        pcall(function() gui:Destroy() end)
        if getgenv then getgenv().__origin_loader_open = nil end
    end)
end

