Library:OnUnload(function()
    S.Aimbot, S.GunMods, S.SilentAim, S.KillAll, S.EspOn = false, false, false, false, false
    S.Fly, S.NoClip, S.Speed, S.Jump, S.InfJump = false, false, false, false, false
    S.Fullbright, S.NoFog, S.FovOn = false, false, false
    S.ChamsOn = false
    pcall(stopFly)
    pcall(disableWallBypass)
    pcall(restoreAllGunMods)
    pcall(function() local h = myHum(); if h then h.WalkSpeed = 16; h.JumpPower = 50 end end)
    pcall(function() for _, e in pairs(chamsState) do restoreParts(e) end end)
    pcall(function() chamsFolder:Destroy() end)
    for _, e in ipairs(espPool) do
        pcall(function()
            e.box:Remove(); e.boxo:Remove(); e.name:Remove(); e.dist:Remove(); e.tracer:Remove()
            for _, l in ipairs(e.bones) do l:Remove() end
        end)
    end
    pcall(function() if dbgLbl then dbgLbl.Parent:Destroy() end end)
end)
