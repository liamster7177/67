local function hrpOf(p) local c = p.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function alive(p)
    local c = p.Character
    return c and c:IsDescendantOf(Workspace) and c:FindFirstChild("HumanoidRootPart") ~= nil
end
local function enemyOf(p, teamCheck)
    if p == LP or not alive(p) then return false end
    if teamCheck and LP.Team ~= nil and p.Team ~= nil and p.Team == LP.Team then return false end
    return true
end
local function keyHeld(name)
    if not name or name == "" or name == "None" then return true end
    if name == "MouseButton2" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
    local ok, code = pcall(function() return Enum.KeyCode[name] end)
    return (ok and code and UIS:IsKeyDown(code)) or false
end
local function headPart(ch) return ch and (ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")) end

local function nearestEnemyModel(pos, teamCheck, maxDist)
    local best, bestD = nil, maxDist or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if enemyOf(p, teamCheck) then
            local h = headPart(p.Character)
            if h then
                local d = (h.Position - pos).Magnitude
                if d < bestD then best, bestD = p.Character, d end
            end
        end
    end
    return best
end

