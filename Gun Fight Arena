local function streakName(slot)
    local n = LP:GetAttribute("Streak" .. slot)
    return (type(n) == "string" and n ~= "") and n or ("Slot " .. slot)
end
local function doStreakCall(slot)
    if net and type(rawget(net, "InvokeServer")) == "function" then
        local ok, res = pcall(function() return net:InvokeServer("Callstreak", slot) end)
        if ok then return true, res, "InvokeServer" end
        if net and type(rawget(net, "FireServer")) == "function" then
            local ok2, res2 = pcall(function() return net:FireServer("Callstreak", slot) end)
            if ok2 then return true, res2, "FireServer(fallback)" end
            return false, res .. " / " .. tostring(res2), "both"
        end
        return false, res, "InvokeServer"
    elseif net and type(rawget(net, "FireServer")) == "function" then
        local ok, res = pcall(function() return net:FireServer("Callstreak", slot) end)
        return ok, res, "FireServer"
    end
    return false, "no Network", "none"
end
local function fireStreak(slot)
    slot = tonumber(slot) or 1
    local ok, res, method = doStreakCall(slot)
    DBG.lastStreak = ("%s -> ok=%s res=%s"):format(method, tostring(ok), tostring(res))
    return ok, res, method
end
