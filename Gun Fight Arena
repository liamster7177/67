local function pickSilentTarget()
    if S.Silent360 then
        local myp = (hrpOf(LP) and hrpOf(LP).Position) or Workspace.CurrentCamera.CFrame.Position
        local best, bestD = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if enemyOf(p, S.SilentTeamCheck) then
                local h = headPart(p.Character)
                if h then local d = (h.Position - myp).Magnitude; if d < bestD then best, bestD = p, d end end
            end
        end
        return best
    else
        local cam = Workspace.CurrentCamera
        local center = cam.ViewportSize / 2
        local best, bestD = nil, S.SilentFOV or 400
        for _, p in ipairs(Players:GetPlayers()) do
            if enemyOf(p, S.SilentTeamCheck) then
                local part = headPart(p.Character)
                if part then
                    local sp, on = cam:WorldToViewportPoint(part.Position)
                    if on and sp.Z > 0 then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < bestD then best, bestD = p, d end
                    end
                end
            end
