local activeTracers = {}
local function makeTracer(fromV, toV)
    if typeof(fromV) ~= "Vector3" or typeof(toV) ~= "Vector3" then return end
    if (toV - fromV).Magnitude < 1 then return end
    pcall(function()
        local near = Instance.new("Attachment"); near.Parent = Workspace.Terrain; near.Position = fromV
        local far  = Instance.new("Attachment"); far.Parent = Workspace.Terrain;  far.Position = toV
        local beam = Instance.new("Beam")
        beam.Attachment0, beam.Attachment1 = near, far
        beam.FaceCamera = true; beam.LightInfluence = 0
        beam.Width0 = S.TracerThickness; beam.Width1 = S.TracerThickness
        beam.Color = ColorSequence.new(S.TracerColor)
        beam.LightEmission = math.clamp(S.TracerEmission or 1, 0, 1)
        beam.Brightness = 10000 ^ ((math.clamp(S.TracerGlow or 6, 1, 25) - 1) / 24)
        local tex = TRACER_STYLES[S.TracerStyle] or ""
        beam.Texture = tex
        if tex ~= "" then beam.TextureLength = 4; beam.TextureSpeed = 1; beam.TextureMode = Enum.TextureMode.Wrap end
        beam.Parent = tracerFolder
        activeTracers[#activeTracers+1] = { beam = beam, near = near, far = far, born = os.clock(), life = S.TracerLife or 0.6 }
    end)
end
RunService.Heartbeat:Connect(function()
    local now = os.clock()
    for i = #activeTracers, 1, -1 do
        local t = activeTracers[i]
        if now - t.born >= t.life then
            pcall(function() t.beam:Destroy(); t.near:Destroy(); t.far:Destroy() end)
            table.remove(activeTracers, i)
        end
    end
end)

