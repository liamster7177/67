local chamsFolder = Instance.new("Folder")
chamsFolder.Name = "ORIGIN_chams"
pcall(function() chamsFolder.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
local CHAMS_STYLES = { "Highlight", "Neon", "ForceField", "Glass" }
local CHAMS_MATERIAL = { Neon = Enum.Material.Neon, ForceField = Enum.Material.ForceField, Glass = Enum.Material.Glass }
local chamsState = {}
local function chamsEntry(model)
    local e = chamsState[model]
    if not e then e = { hl = nil, parts = {} }; chamsState[model] = e end
    return e
end
local function restoreParts(e)
    for part, o in pairs(e.parts) do
        pcall(function() if part and part.Parent then part.Material = o.mat; part.Color = o.col; part.Transparency = o.tr end end)
    end
    e.parts = {}
end
local function applyChams(model, color)
    if not model then return end
    local e = chamsEntry(model)
    local style = S.ChamsStyle or "Highlight"
    if style == "Highlight" then
        restoreParts(e)
        local hl = e.hl
        if not hl or hl.Parent ~= chamsFolder then
            hl = Instance.new("Highlight"); hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = chamsFolder; e.hl = hl
        end
        pcall(function()
            hl.Adornee = model
            hl.FillColor = color; hl.OutlineColor = S.ChamsOutline
            hl.FillTransparency = S.ChamsFillT; hl.OutlineTransparency = 0; hl.Enabled = true
        end)
    else
        if e.hl then pcall(function() e.hl.Enabled = false end) end
        local mat = CHAMS_MATERIAL[style] or Enum.Material.Neon
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                if e.parts[d] == nil then e.parts[d] = { mat = d.Material, col = d.Color, tr = d.Transparency } end
                pcall(function()
                    d.Material = mat
                    d.Color = color
                    if style == "Glass" then d.Transparency = 0.35
                    elseif style == "ForceField" then d.Transparency = 0 end
                end)
            end
        end
    end
end
