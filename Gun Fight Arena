end)

local espPool = {}
local function getEsp(i)
    local e = espPool[i]; if e then return e end
    local box = Drawing.new("Square"); box.Thickness, box.Filled, box.Visible = 1, false, false
    local boxo = Drawing.new("Square"); boxo.Thickness, boxo.Filled, boxo.Visible, boxo.Color = 3, false, false, Color3.new(0,0,0)
    local name = Drawing.new("Text"); name.Size, name.Center, name.Outline, name.Visible = 13, true, true, false
    local dist = Drawing.new("Text"); dist.Size, dist.Center, dist.Outline, dist.Visible = 12, true, true, false
    local tracer = Drawing.new("Line"); tracer.Thickness, tracer.Visible = 1, false
    local bones = {}
    for k = 1, 10 do local l = Drawing.new("Line"); l.Thickness, l.Visible = 1, false; bones[k] = l end
    e = { box=box, boxo=boxo, name=name, dist=dist, tracer=tracer, bones=bones }
    espPool[i] = e
    return e
end
local function hideEsp(e)
    e.box.Visible, e.boxo.Visible, e.name.Visible, e.dist.Visible, e.tracer.Visible = false,false,false,false,false
    for _, l in ipairs(e.bones) do l.Visible = false end
end
local R15_BONES = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"}, {"LowerTorso","RightUpperLeg"},
}
RunService.RenderStepped:Connect(function()
    local idx = 0
    pcall(function()
        if Cam ~= Workspace.CurrentCamera then Cam = Workspace.CurrentCamera end
        if not S.EspOn then return end
        local origin = (hrpOf(LP) and hrpOf(LP).Position) or Cam.CFrame.Position
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and alive(p) then
                local enemy = not (LP.Team ~= nil and p.Team ~= nil and p.Team == LP.Team)
                if not (S.EspTeamCheck and not enemy) then
                    local char = p.Character
                    local hrp, head = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Head")
                    if hrp and head then
                        local dist = (hrp.Position - origin).Magnitude
                        if dist <= S.EspMaxDist then
                            idx = idx + 1
                            local e = getEsp(idx)
                            local col = enemy and S.EspEnemy or S.EspAlly
                            local hp, hv = Cam:WorldToViewportPoint(head.Position + Vector3.new(0,0.6,0))
                            local lpp = Cam:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
                            if hv and hp.Z > 0 then
                                local h = math.abs(lpp.Y - hp.Y); local w = h * 0.5
                                local bx, by = hp.X - w/2, hp.Y
                                if S.EspBox then
                                    e.boxo.Size = Vector2.new(w,h); e.boxo.Position = Vector2.new(bx,by); e.boxo.Visible = true
                                    e.box.Size = Vector2.new(w,h); e.box.Position = Vector2.new(bx,by); e.box.Color = col; e.box.Visible = true
                                else e.box.Visible, e.boxo.Visible = false, false end
                                if S.EspName then
                                    e.name.Text = p.DisplayName or p.Name
                                    e.name.Position = Vector2.new(hp.X, by-15); e.name.Color = col; e.name.Visible = true
                                else e.name.Visible = false end
                                if S.EspDist then
                                    e.dist.Text = string.format("%dm", math.floor(dist))
                                    e.dist.Position = Vector2.new(hp.X, by+h+2); e.dist.Color = col; e.dist.Visible = true
                                else e.dist.Visible = false end
                                if S.EspTracer then
                                    e.tracer.From = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y)
                                    e.tracer.To = Vector2.new(hp.X, by+h); e.tracer.Color = col; e.tracer.Visible = true
                                else e.tracer.Visible = false end
                                if S.EspSkeleton then
                                    for bi, pair in ipairs(R15_BONES) do
                                        local l = e.bones[bi]
                                        local aa, bb = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
                                        if aa and bb then
                                            local pa, va = Cam:WorldToViewportPoint(aa.Position)
                                            local pb, vb = Cam:WorldToViewportPoint(bb.Position)
                                            if va and vb and pa.Z > 0 and pb.Z > 0 then
                                                l.From = Vector2.new(pa.X,pa.Y); l.To = Vector2.new(pb.X,pb.Y); l.Color = col; l.Visible = true
                                            else l.Visible = false end
                                        else l.Visible = false end
                                    end
                                else for _, l in ipairs(e.bones) do l.Visible = false end end
                            else hideEsp(e) end
                        end
                    end
                end
            end
        end
    end)
    for i = idx + 1, #espPool do hideEsp(espPool[i]) end
end)

