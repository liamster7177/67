local function fakeFireOrigin(args, targetHead)
    if not (S.FakeOrigin and targetHead) then return args end
    local camPos = Workspace.CurrentCamera.CFrame.Position
    local dir = targetHead.Position - camPos
    dir = (dir.Magnitude < 1) and Vector3.new(0, 0, -1) or dir.Unit
    local originPos = targetHead.Position - dir * (S.FakeOriginDist or 4)
    local newCF = CFrame.new(originPos, targetHead.Position)
    for i = 1, args.n do
        local v = args[i]
        if typeof(v) == "CFrame" then args[i] = newCF; break
        elseif typeof(v) == "Vector3" then args[i] = originPos; break end
    end
    return args
end
local lastInner = nil
local forging = false
if net and rawget(net, "FireServer") then
    local oldSend
    oldSend = hookfunction(net.FireServer, function(self, action, ...)
        if not forging then
            if action == "Hitcheck" then
                pcall(function(...)
                    local a = { ... }
                    local inner = a[4]
                    if type(inner) == "table" then
                        lastInner = { inner[1], inner[2], inner[3] }
                        DBG.lastCal = tostring(inner[1])
                        if typeof(inner[4]) == "Vector3" then fxOnHit(inner[4]) end
                    end
                end, ...)
            elseif action == "Fire" and (S.SilentAim or S.KillAll or S.RageBot) and lastInner then
                local targets = {}
                if S.KillAll or S.RageBot then
                    for _, p in ipairs(Players:GetPlayers()) do if enemyOf(p, S.SilentTeamCheck) then targets[#targets+1] = p end end
                else
                    local best = pickSilentTarget(); if best then targets[1] = best end
                end
                local primary = targets[1]
                local primaryHead = primary and headPart(primary.Character)
                local args = table.pack(...)
                args = fakeFireOrigin(args, primaryHead)
                local result = oldSend(self, action, table.unpack(args, 1, args.n))
                forging = true
                pcall(function()
                    for _, p in ipairs(targets) do
                        local h = headPart(p.Character)
                        if h then
                            oldSend(self, "Hitcheck", Workspace, p.Name, "HumanoidRootPart",
                                { lastInner[1], lastInner[2], lastInner[3], h.Position, "Head" })
                            fxOnHit(h.Position)
                        end
                    end
                end)
                forging = false
                return result
            end
        end
        return oldSend(self, action, ...)
    end)
end

